{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "taurus",
  "version": "0.1.0",
  "description": "High-performance XML parser and XPath 1.0 engine in pure C",
  "homepage": "https://github.com/lutaml/taurus",
  "license": "MIT",
  "dependencies": [
    {
      "name": "utf8proc"
    }
  ],
  "features": {
    "iconv": {
      "description": "Enable encoding conversion via iconv",
      "dependencies": [
        {
          "name": "libiconv",
          "platform": "!osx"
        }
      ]
    },
    "tests": {
      "description": "Build test suite",
      "dependencies": [
        {
          "name": "gtest",
          "platform": "!windows"
        }
      ]
    }
  },
  "default-features": ["iconv"],
  "builtin-baseline": "cd5e746ec203c8c3c61647e0886a8df8c1e78e41"
}
