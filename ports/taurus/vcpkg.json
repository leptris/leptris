{
  "name": "taurus",
  "version": "0.1.0",
  "description": "High-performance XML parser and XPath 1.0 engine in pure C",
  "homepage": "https://github.com/lutaml/taurus",
  "license": "BSD-2-Clause",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "utf8proc"
    }
  ],
  "features": {
    "iconv": {
      "description": "Enable encoding conversion via iconv",
      "dependencies": [
        {
          "name": "libiconv",
          "platform": "!osx"
        }
      ]
    },
    "cli": {
      "description": "Build the taurus CLI tool"
    }
  },
  "default-features": []
}
