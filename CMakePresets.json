{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default portable Release build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "fast",
      "displayName": "Maximum single-machine throughput (non-portable)",
      "description": "Bundles -O3, -march=native, LTO, and static linking. Use for production builds on the host CPU only.",
      "binaryDir": "${sourceDir}/build-fast",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TAURUS_OPT_LEVEL": "aggressive",
        "TAURUS_TARGET_ARCH": "native",
        "TAURUS_ENABLE_LTO": "ON",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "pgo-generate",
      "displayName": "PGO instrumentation pass",
      "description": "Build with PGO instrumentation; run your workload, then re-configure with 'pgo-use'.",
      "binaryDir": "${sourceDir}/build-pgo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TAURUS_ENABLE_PGO": "GENERATE"
      }
    },
    {
      "name": "pgo-use",
      "displayName": "PGO optimized build",
      "description": "Re-uses the profile generated by 'pgo-generate'. Run ctest or your app between the two passes.",
      "binaryDir": "${sourceDir}/build-pgo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TAURUS_ENABLE_PGO": "USE",
        "TAURUS_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug build with ASAN",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TAURUS_ENABLE_ASAN": "ON"
      }
    }
  ]
}
