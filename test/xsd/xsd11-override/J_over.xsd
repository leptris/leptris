<?xml version="1.0" encoding="UTF-8"?>
<!-- #2150 (saxon over026): ghost overrides nothing, so it is
 * IGNORED — and the kept para's reference to it no longer resolves:
 * schema error. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:override schemaLocation="J_base.xsd">
    <xs:element name="para" type="ghost"/>
    <xs:simpleType name="ghost">
      <xs:restriction base="xs:date">
        <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}Z"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:override>
</xs:schema>
