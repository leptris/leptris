<?xml version="1.0" encoding="UTF-8"?>
<!-- #2150: the OVERRIDING document. dateStr is replaced wholesale —
 * no derivation relationship required. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:override schemaLocation="A_base.xsd">
    <xs:simpleType name="dateStr">
      <xs:restriction base="xs:date">
        <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}Z"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:override>
</xs:schema>
