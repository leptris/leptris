<?xml version="1.0" encoding="UTF-8"?>
<!-- #2156 / §3.11.3 cl. 5: a ref must resolve to a constraint of the
     SAME category — xs:key ref pointing at a unique is a schema
     error. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="http://ex.io/ic"
           targetNamespace="http://ex.io/ic"
           elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sec" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="nr"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="u1">
      <xs:selector xpath="s:sec"/>
      <xs:field xpath="@nr"/>
    </xs:unique>
    <xs:key ref="s:u1"/>
  </xs:element>
</xs:schema>
