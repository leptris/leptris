<?xml version="1.0" encoding="UTF-8"?>
<!-- #2156: the '.' field (the selected node's own string value,
     §3.11.6.3 [7] with Step '.') and the './' spelled form. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="http://ex.io/ic"
           targetNamespace="http://ex.io/ic"
           elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="num" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="id"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="u1">
      <xs:selector xpath="./s:num"/>
      <xs:field xpath="."/>
    </xs:unique>
  </xs:element>
</xs:schema>
