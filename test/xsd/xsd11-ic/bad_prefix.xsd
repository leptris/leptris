<?xml version="1.0" encoding="UTF-8"?>
<!-- #2156 / §3.13.2: a selector prefix with no in-scope declaration
     in the SCHEMA document is a schema error (XPath Valid). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://ex.io/ic"
           elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sec" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="nr"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="u1">
      <xs:selector xpath="zzz:sec"/>
      <xs:field xpath="@nr"/>
    </xs:unique>
  </xs:element>
</xs:schema>
