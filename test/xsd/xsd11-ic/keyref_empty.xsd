<?xml version="1.0" encoding="UTF-8"?>
<!-- #2156: a keyref against a key whose target node set is EMPTY —
     the node table exists but has no entries, so every keyref tuple
     must FAIL (§3.11.4 cl. 4.3: an entry must exist). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="http://ex.io/ic"
           targetNamespace="http://ex.io/ic"
           elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sec" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="nr"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="ref" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="to"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:key name="k1">
      <xs:selector xpath="s:sec"/>
      <xs:field xpath="@nr"/>
    </xs:key>
    <xs:keyref name="r1" refer="k1">
      <xs:selector xpath="s:ref"/>
      <xs:field xpath="@to"/>
    </xs:keyref>
  </xs:element>
</xs:schema>
