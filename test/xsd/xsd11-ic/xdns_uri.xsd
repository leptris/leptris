<?xml version="1.0" encoding="UTF-8"?>
<!-- #2156: xpathDefaultNamespace as a literal URI at the schema
     level (§3.13.2 {default namespace}, the id050 shape). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://ex.io/ic"
           elementFormDefault="qualified"
           xpathDefaultNamespace="http://ex.io/ic">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sec" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="nr"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="u1">
      <xs:selector xpath="sec"/>
      <xs:field xpath="@nr"/>
    </xs:unique>
  </xs:element>
</xs:schema>
