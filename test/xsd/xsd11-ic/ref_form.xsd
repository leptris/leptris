<?xml version="1.0" encoding="UTF-8"?>
<!-- #2156: constraint reuse via @ref (§3.11.2): the key and keyref
     named on `list` are re-used on `other` by ref; both scopes are
     evaluated under the same constraint names. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="http://ex.io/ic"
           targetNamespace="http://ex.io/ic"
           elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="list" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sec" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="nr"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="ref" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="to"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
          <xs:key name="k1">
            <xs:selector xpath="s:sec"/>
            <xs:field xpath="@nr"/>
          </xs:key>
          <xs:keyref name="r1" refer="k1">
            <xs:selector xpath="s:ref"/>
            <xs:field xpath="@to"/>
          </xs:keyref>
        </xs:element>
        <xs:element name="other" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sec" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="nr"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="ref" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="to"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
          <xs:key ref="s:k1"/>
          <xs:keyref ref="s:r1"/>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
