<?xml version="1.0" encoding="UTF-8"?>
<!-- #2156: a VACUOUS xs:unique — zero selected nodes satisfies the
     constraint (§3.11.4: the qualified node set may be empty). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="http://ex.io/ic"
           targetNamespace="http://ex.io/ic"
           elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="other" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="x"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="u1">
      <xs:selector xpath="s:sec"/>
      <xs:field xpath="@nr"/>
    </xs:unique>
  </xs:element>
</xs:schema>
