<?xml version="1.0"?>
<!-- #2155: a derived maxScale above the base's widens the value
     space — schema error (d3_3_4si28 / pdecimal013.n). -->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://leptris.test/dt/scale_narrow_max"
	xmlns:t="http://leptris.test/dt/scale_narrow_max">
<simpleType name="t">
	<restriction base="precisionDecimal">
		<minScale value="4"/>
		<maxScale value="8"/>
	</restriction>
</simpleType>
<simpleType name="u">
	<restriction base="t:t">
		<maxScale value="9"/>
	</restriction>
</simpleType>
<element name="root" type="t:u"/>
</schema>
