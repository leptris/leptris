<?xml version="1.0"?>
<!-- #2155: a FIXED base facet cannot be re-specified with a
     different value (d3_3_4si24) — totalDigits 4 under a base
     fixed at 5 is a schema error. -->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://leptris.test/dt/fixed_totaldigits"
	xmlns:t="http://leptris.test/dt/fixed_totaldigits">
<simpleType name="fixedBase">
	<restriction base="precisionDecimal">
		<totalDigits value="5" fixed="true"/>
	</restriction>
</simpleType>
<simpleType name="derived">
	<restriction base="t:fixedBase">
		<totalDigits value="4"/>
	</restriction>
</simpleType>
<element name="root" type="t:derived"/>
</schema>
