<?xml version="1.0"?>
<!-- #2155: a negative totalDigits value is an invalid facet value
     (d3_3_4si18). -->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://leptris.test/dt/totaldigits_negative"
	xmlns:t="http://leptris.test/dt/totaldigits_negative">
<simpleType name="decTotalDigits">
	<restriction base="precisionDecimal">
		<totalDigits value="-3"/>
	</restriction>
</simpleType>
<element name="root" type="t:decTotalDigits"/>
</schema>
