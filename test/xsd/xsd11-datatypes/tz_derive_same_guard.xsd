<?xml version="1.0" encoding="UTF-8"?>
<!-- The guard: the SAME posture derives clean; from the bare builtin
     any posture is a first choice. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="a" type="req"/>
        <xs:element name="b" type="req2"/>
        <xs:element name="c" type="first-optional"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="req">
    <xs:restriction base="xs:time">
      <xs:explicitTimezone value="required"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="req2">
    <xs:restriction base="req">
      <xs:explicitTimezone value="required"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="first-optional">
    <xs:restriction base="xs:time">
      <xs:explicitTimezone value="optional"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
