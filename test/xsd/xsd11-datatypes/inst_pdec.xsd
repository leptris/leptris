<?xml version="1.0"?>
<!-- #2155: precisionDecimal — the arithmetic value space (same
     lexical as decimal), with ordered bounds enforced. -->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://leptris.test/dt/inst_pdec"
	xmlns:t="http://leptris.test/dt/inst_pdec">
<simpleType name="t">
	<restriction base="precisionDecimal">
		<minInclusive value="1"/>
		<maxExclusive value="10"/>
	</restriction>
</simpleType>
<element name="root" type="t:t"/>
</schema>
