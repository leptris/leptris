<?xml version="1.0"?>
<!-- #2155: whiteSpace on the duration family is fixed at collapse
     (d3_4_26si10). -->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://leptris.test/dt/ws_replace_ymd"
	xmlns:t="http://leptris.test/dt/ws_replace_ymd">
<simpleType name="t">
	<restriction base="yearMonthDuration">
		<whiteSpace value="replace"/>
	</restriction>
</simpleType>
<element name="root" type="t:t"/>
</schema>
