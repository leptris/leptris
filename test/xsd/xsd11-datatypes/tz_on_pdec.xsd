<?xml version="1.0"?>
<!-- #2155: explicitTimezone applies to the date/time family only —
     on precisionDecimal it is an inapplicable facet. -->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://leptris.test/dt/tz_on_pdec"
	xmlns:t="http://leptris.test/dt/tz_on_pdec">
<simpleType name="t">
	<restriction base="precisionDecimal">
		<explicitTimezone value="required"/>
	</restriction>
</simpleType>
<element name="root" type="t:t"/>
</schema>
