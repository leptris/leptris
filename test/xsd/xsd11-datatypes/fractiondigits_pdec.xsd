<?xml version="1.0"?>
<!-- #2155: fractionDigits is not applicable to precisionDecimal
     (d3_3_4si20 / pdecimal009.n). -->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://leptris.test/dt/fractiondigits_pdec"
	xmlns:t="http://leptris.test/dt/fractiondigits_pdec">
<simpleType name="t">
	<restriction base="precisionDecimal">
		<fractionDigits value="4"/>
	</restriction>
</simpleType>
<element name="root" type="t:t"/>
</schema>
