<?xml version="1.0" encoding="UTF-8"?>
<!-- The guard (target001): targetNamespace on a LOCAL declaration is
     legal inside a complexType RESTRICTION, without @form. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:complexType name="B" abstract="true">
    <xs:sequence>
      <xs:any namespace="http://www.tns-loc.com/" processContents="lax"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="R">
    <xs:complexContent>
      <xs:restriction base="B">
        <xs:sequence>
          <xs:element name="child" targetNamespace="http://www.tns-loc.com/" type="xs:integer"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="parent" type="R"/>
</xs:schema>
