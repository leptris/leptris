<?xml version="1.0" encoding="UTF-8"?>
<!-- zone008: explicitTimezone on a UNION base — the union admits only
     the common facets; the schema is a schema error. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="doc" type="timeStamp"/>
  <xs:simpleType name="timeStamp">
    <xs:restriction>
      <xs:simpleType>
        <xs:union memberTypes="xs:date xs:time"/>
      </xs:simpleType>
      <xs:explicitTimezone value="required"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
