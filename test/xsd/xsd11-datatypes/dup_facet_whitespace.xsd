<?xml version="1.0" encoding="UTF-8"?>
<!-- simple084: whiteSpace twice with DIFFERENT values — the schema
     is a schema error, not an overwrite-last-wins. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="root" type="t-ws"/>
  <xs:simpleType name="t-ws">
    <xs:restriction base="xs:string">
      <xs:whiteSpace value="collapse"/>
      <xs:whiteSpace value="preserve"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
