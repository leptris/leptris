<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<!-- #2183 (d4_3_15ii14+ii31 cluster): ABSOLUTE paths in an
	     assert test see NOTHING — the assertion data model contains
	     only the validated element's subtree (§3.13.4.1 cl. 1.3),
	     so '/' and '//' are unsuccessful references, not errors.
	     The assertion holds exactly when //ele1 counts zero. A
	     document-rooting engine counts 2 here (wrongly valid); a
	     subtree-rooting engine counts 1 (wrongly valid). -->
	<xs:element name="root" type="rootType"/>
	<xs:complexType name="rootType">
		<xs:sequence>
			<xs:element name="ele1" type="elementType1" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="ele2" type="elementType2" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="elementType1">
		<xs:sequence>
			<xs:element name="subElement1" type="rootType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="elementType2">
		<xs:sequence>
			<xs:element name="subElement2" type="rootType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:assert test="count(//ele1) eq 0"/>
	</xs:complexType>

</xs:schema>
