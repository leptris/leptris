<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified" attributeFormDefault="unqualified">

  <!-- #2183 absent focus: the context item is undefined during
       simple-type assertion validation (assert-simple008). "."
       raises XPDY0002, the assertion does not hold. -->

  <xs:element name="date">
    <xs:simpleType>
      <xs:restriction base="xs:date">
        <xs:assertion test=". castable as xs:date"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:element>

  <xs:element name="outer">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="date" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
