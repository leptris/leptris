<?xml version="1.0" encoding="UTF-8"?>
<!-- xs:all extends xs:all: the particle sets merge (§3.4.4.2,
     cos-ct-extends) and the instance interleaves freely -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:complexType name="b">
    <xs:all>
      <xs:element name="a" minOccurs="0" maxOccurs="5"/>
      <xs:element name="b" minOccurs="1" maxOccurs="5"/>
      <xs:element name="c" minOccurs="2" maxOccurs="unbounded"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="e">
    <xs:complexContent>
      <xs:extension base="b">
        <xs:all>
          <xs:element name="e" minOccurs="1" maxOccurs="1"/>
          <xs:element name="f" minOccurs="1" maxOccurs="4"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="doc" type="e"/>
</xs:schema>
