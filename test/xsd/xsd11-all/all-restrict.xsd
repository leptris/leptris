<?xml version="1.0" encoding="UTF-8"?>
<!-- legal restriction of an all-group base (s3_3_6v04 shape):
     element-for-element within bounds, wildcard narrowed -->
<xs:schema xmlns="http://www.w3.org/2001/XMLSchema"
           targetNamespace="a" xmlns:a="a">
  <complexType name="c">
    <all>
      <element name="e1" type="integer"/>
      <any processContents="lax" maxOccurs="2"/>
    </all>
  </complexType>
  <complexType name="d">
    <complexContent>
      <restriction base="a:c">
        <all>
          <element name="e1" type="integer"/>
          <any processContents="lax" maxOccurs="2"/>
        </all>
      </restriction>
    </complexContent>
  </complexType>
  <element name="root" type="a:d"/>
</schema>
