<?xml version="1.0" encoding="UTF-8"?>
<!-- relaxed xs:all with substitution groups: members count toward
     the head's occurrence window -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="doc">
    <xs:complexType>
      <xs:all>
        <xs:element ref="c" minOccurs="2" maxOccurs="3"/>
        <xs:element name="d" minOccurs="1" maxOccurs="1"/>
      </xs:all>
    </xs:complexType>
  </xs:element>
  <xs:element name="c"/>
  <xs:element name="C" substitutionGroup="c"/>
  <xs:element name="d"/>
</xs:schema>
