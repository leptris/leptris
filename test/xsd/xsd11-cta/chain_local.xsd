<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified">

  <!-- #2149: the same chain on a LOCAL element particle inside a
       content model — the particle itself carries the alternatives. -->
  <xs:complexType name="shape">
    <xs:sequence><xs:element name="r" type="xs:integer"/></xs:sequence>
    <xs:attribute name="kind" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="circle">
    <xs:complexContent>
      <xs:restriction base="shape">
        <xs:sequence><xs:element name="r" type="xs:positiveInteger"/></xs:sequence>
        <xs:attribute name="kind" type="xs:string"/>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="s" type="shape" maxOccurs="unbounded">
          <xs:alternative test="@kind='circle'" type="circle"/>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
