<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified">

  <!-- #2149 (§3.12.4): a dynamic/compile error in a test evaluates
       the alternative as FALSE — the declared type stands. The
       malformed test must not reject the document. -->
  <xs:complexType name="base">
    <xs:sequence><xs:element name="a" type="xs:string"/></xs:sequence>
  </xs:complexType>

  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="e" type="base" maxOccurs="unbounded">
          <xs:alternative test="@k === 'broken'" type="xs:error"/>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
