<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified">

  <!-- #2149: the FINAL alternative carries no test — it is the type
       table's default type definition (§3.3.2.1 {default type
       definition}). No test matching falls back to the en-only
       content model, NOT to the (absent) declared type. -->
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="chap" maxOccurs="unbounded">
          <xs:alternative test="@lang='de'">
            <xs:complexType>
              <xs:sequence><xs:element name="de"/></xs:sequence>
            </xs:complexType>
          </xs:alternative>
          <xs:alternative>
            <xs:complexType>
              <xs:sequence><xs:element name="en"/></xs:sequence>
            </xs:complexType>
          </xs:alternative>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
