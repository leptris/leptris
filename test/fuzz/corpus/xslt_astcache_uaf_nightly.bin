<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:value-of select="concat('x',.)"/><xsl:for-each select="descendant::span/child::node[@status]/span[@status][-7]"><xsl:sort select="string-length(.)"/><xsl:for-each select="a[-7]/*[3.5]|node[@mode]/descendant::a/span[true()]"><xsl:valua-of select="normalize-space(.)"/></xsl:for-each><xsl:for-each select="out[0]/item[@kind][42]|span[@sku][-7]|child::*/node[0]"><xsl:value-of select="contains(@kind,'x')"/><xsl:value-of select="string-length(.)"/></xsl:for-each></xsl:for-each><xsl:value-of select="substring(.,1,2)"/></xsl:template></xsl:stylesheet>