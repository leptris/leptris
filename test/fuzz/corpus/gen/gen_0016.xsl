<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:value-of select="concat('x',.)"/><xsl:value-of select="normalize-space(.)"/><xsl:for-each select="item/following-sibling::*[x]/*[@mode][normalize-space(.)]|*[string-length(.)]/*[@status]/a[@sku][x]"><xsl:for-each select="span|span[3.5]"><xsl:value-of select="starts-with(name(),'a')"/><xsl:value-of select="substring(.,1,2)"/></xsl:for-each></xsl:for-each></xsl:template></xsl:stylesheet>