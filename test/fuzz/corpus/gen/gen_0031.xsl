<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:if test="a[@status]"><xsl:if test="-7 &lt; 0"><xsl:value-of select="normalize-space(.)"/></xsl:if><xsl:for-each select="span[3.5]/child::item|child::out/r[-7]/r[@status]|b[@mode]/following-sibling::out"><xsl:value-of select="string-length(.)"/></xsl:for-each><xsl:for-each select="//node/out[@kind][42]/b|a/ancestor::r/leaf|descendant::*[@mode][0]/item[@mode]"><a>@kind</a></xsl:for-each></xsl:if><xsl:for-each select="//ancestor::r/ancestor::node/leaf[@id]"><xsl:for-each select="//b/*[@mode][true()]"><xsl:sort select="normalize-space(.)"/><xsl:value-of select="starts-with(name(),'a')"/><xsl:value-of select="contains(@kind,'x')"/></xsl:for-each><xsl:value-of select="round(number(@id))"/><node>@kind</node></xsl:for-each></xsl:template></xsl:stylesheet>