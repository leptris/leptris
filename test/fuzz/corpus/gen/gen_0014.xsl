<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:for-each select="child::out[@mode]/child::item/span"><xsl:sort select="out/child::* != leaf[@sku]/out[@kind]"/><xsl:if test="out/item"><item>@sku</item><xsl:value-of select="starts-with(name(),'a')"/></xsl:if><xsl:for-each select="*[@status][0]/a[@id]"><xsl:sort select="true()"/><xsl:value-of select="number(@id)"/></xsl:for-each><xsl:for-each select="//span|node[@mode]"><xsl:value-of select="round(number(@id))"/><xsl:value-of select="round(number(@id))"/><xsl:value-of select="string-length(.)"/></xsl:for-each></xsl:for-each><out>@status</out><leaf>@kind</leaf></xsl:template></xsl:stylesheet>