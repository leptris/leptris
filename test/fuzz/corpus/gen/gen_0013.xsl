<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:for-each select="a[@status]/*[@sku]/r|//out[x]|node[@kind]/r[(-7)]"><xsl:for-each select="out[@kind]/descendant::leaf[@id]/descendant::a[@status]|a[true()]/r/span[0]"><xsl:value-of select="concat('x',.)"/><xsl:value-of select="number(@id)"/></xsl:for-each><xsl:for-each select="*[@kind]/*"><xsl:value-of select="round(number(@id))"/><xsl:value-of select="substring(.,1,2)"/></xsl:for-each><xsl:if test="0"><xsl:value-of select="normalize-space(.)"/><xsl:value-of select="round(number(@id))"/></xsl:if></xsl:for-each></xsl:template></xsl:stylesheet>