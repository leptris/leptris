<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><leaf>@sku</leaf><xsl:for-each select="node/a[@kind]/span[@id]|//leaf[@mode]/descendant::node[@status]/r[(-7)]"><xsl:value-of select="string-length(.)"/><xsl:if test="(3.5)"><xsl:value-of select="round(number(@id))"/><item>@status</item><xsl:value-of select="concat('x',.)"/></xsl:if><xsl:for-each select="r[@kind]"><xsl:sort select="true()"/><xsl:value-of select="a/leaf"/><xsl:value-of select="number(@id)"/></xsl:for-each></xsl:for-each></xsl:template></xsl:stylesheet>