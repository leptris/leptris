<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:for-each select="b|//child::node[@mode]/leaf[3.5 > 0]/node[(3.5)]"><xsl:for-each select="descendant::leaf/ancestor::span[@kind]/leaf"><xsl:value-of select="round(number(@id))"/><xsl:value-of select="number(@id)"/><xsl:value-of select="round(number(@id))"/></xsl:for-each><xsl:for-each select="a[@mode][3.5]|span[@id]"><xsl:value-of select="contains(@kind,'x')"/><xsl:value-of select="round(number(@id))"/><xsl:value-of select="number(@id)"/></xsl:for-each><xsl:for-each select="//leaf/leaf[@sku]/leaf[@id]|descendant::node|descendant::r[@mode]/*/b[@mode]"><xsl:value-of select="out[0]/span[@status]/descendant::r"/><xsl:value-of select="substring(.,1,2)"/></xsl:for-each></xsl:for-each><xsl:for-each select="//r[@id][42]/r|node/out/*"><xsl:if test="42 >= -7"><xsl:value-of select="normalize-space(.)"/><out>@id</out></xsl:if><a>@mode</a></xsl:for-each><xsl:value-of select="concat('x',.)"/></xsl:template></xsl:stylesheet>