<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:if test="a/r[42]/span"><xsl:if test="3.5 > 0"><xsl:value-of select="concat('x',.)"/><xsl:value-of select="contains(@kind,'x')"/><out>@status</out></xsl:if><xsl:for-each select="*/a/leaf"><xsl:sort select="-7"/><node>@status</node><xsl:value-of select="string-length(.)"/></xsl:for-each></xsl:if><xsl:if test="(true())"><xsl:for-each select="leaf[0]|//leaf/child::a[-7]/node|child::out/descendant::item/item"><xsl:value-of select="round(number(@id))"/><xsl:value-of select="round(number(@id))"/></xsl:for-each></xsl:if><xsl:if test="a[@status]/leaf[true() + 42]"><leaf>@status</leaf><xsl:for-each select="child::span[@id][0]|item[0]/out[@id][x]/node[@id]"><xsl:value-of select="string-length(.)"/><xsl:value-of select="string-length(.)"/><xsl:value-of select="concat('x',.)"/></xsl:for-each></xsl:if></xsl:template></xsl:stylesheet>