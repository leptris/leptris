<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:for-each select="a[@id]/descendant::b/*|leaf[@status]/leaf[@kind]/span[@kind]|b[@sku][(-7)]"><xsl:if test="true() + 42"><xsl:value-of select="concat('x',.)"/><xsl:value-of select="starts-with(name(),'a')"/><xsl:value-of select="string-length(.)"/></xsl:if></xsl:for-each><xsl:if test="r[-7]"><xsl:value-of select="number(@id)"/><xsl:for-each select="*[@status]/leaf"><xsl:sort select="substring(.,1,2)"/><xsl:value-of select="round(number(@id))"/></xsl:for-each></xsl:if></xsl:template></xsl:stylesheet>