<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"><xsl:template match="/"><xsl:if test="x mod 3.5 >= 42"><xsl:for-each select="item[@status]/descendant::leaf[@id][3.5]|out[-7]|//out/descendant::span[0]/descendant::span"><xsl:value-of select="contains(@kind,'x')"/><xsl:value-of select="normalize-space(.)"/><out>@id</out></xsl:for-each><xsl:for-each select="r/*[@kind]/r[@mode]|//a[@kind]/child::*[@mode]/ancestor::leaf[@status]"><xsl:value-of select="string-length(.)"/><item>@kind</item></xsl:for-each><xsl:value-of select="concat('x',.)"/></xsl:if><xsl:for-each select="//*[x]/span/child::*|span[@sku]"><xsl:value-of select="round(number(@id))"/><xsl:for-each select="*/ancestor::*/item|child::span[@mode][-7]/a[@sku][x]"><xsl:value-of select="normalize-space(.)"/></xsl:for-each></xsl:for-each></xsl:template></xsl:stylesheet>