@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# taurus records its link dependencies (utf8proc, Iconv, m) on the
# taurus_static / taurus_shared targets' INTERFACE_LINK_LIBRARIES,
# so a downstream project does not need to find_dependency() them
# manually.  No additional find_dependency() calls here.

if(NOT TARGET taurus::taurus)
    include("${CMAKE_CURRENT_LIST_DIR}/taurus-targets.cmake")
endif()

check_required_components(taurus)
